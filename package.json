{
  "name": "dienstplan-sync-checks",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:check": "node scripts/build.cjs --check",
    "format": "prettier --write src scripts .prettierrc.json eslint.config.mjs",
    "format:check": "prettier --check src scripts .prettierrc.json eslint.config.mjs",
    "lint": "eslint .",
    "version:check": "node scripts/check-version.cjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.cjs",
    "pretest:browser": "npm run build",
    "test:browser": "node --test tests/settings-ui.browser.cjs",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "playwright": "1.58.2",
    "prettier": "3.6.2"
  }
}
